      "religious_compatibility": [
        { "key": "accept_different_religion", "label": "Accept Different Religion", "type": "boolean", "required": false, "visible": true, "dependency": {}, "options": [true, false] },
        { "key": "accept_different_community", "label": "Accept Different Community", "type": "boolean", "required": false, "visible": true, "dependency": {}, "options": [true, false] },
        { "key": "accept_different_caste", "label": "Accept Different Caste", "type": "boolean", "required": false, "visible": true, "dependency": {}, "options": [true, false] },
        { "key": "accept_different_gotra", "label": "Accept Different Gotra", "type": "boolean", "required": false, "visible": true, "dependency": {}, "options": [true, false] }
      ],
      "deal_breakers": [
        { "key": "deal_breakers", "label": "Deal Breakers", "type": "object", "required": false, "visible": true, "dependency": {},
          "shape": { "must_have": "string[]", "nice_to_have": "string[]", "avoid": "string[]" },
          "options": [] }
      ]
    }
  }
}
