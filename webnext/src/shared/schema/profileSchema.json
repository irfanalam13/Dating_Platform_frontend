        //
        //  { "key": "personal_religious_practice", "label": "Personal Religious Practice", "type": "select", "required": false, "visible": true, "visibility": "public", "dependency": { "field": "religion", "op": "isSet" }, "options": ["very_religious", "religious", "moderate", "spiritual", "not_practicing"] },
        { "key": "temple_attendance", "label": "Temple Attendance", "type": "select", "required": false, "visible": true, "visibility": "public", "dependency": { "field": "religion", "op": "equals", "value": "Hindu" }, "options": ["daily", "weekly", "monthly", "festivals_only", "rarely"] },
        { "key": "marriage_tradition_pref", "label": "Marriage Tradition Preference", "type": "select", "required": false, "visible": true, "visibility": "public", "dependency": { "field": "religion", "op": "isSet" }, "options": ["traditional", "love", "love_cum_arranged", "court", "no_preference"] }
      ],
      "lifestyle": [
        { "key": "diet", "label": "Diet", "type": "select", "required": false, "visible": true, "visibility": "public", "dependency": {}, "options": ["vegetarian", "eggetarian", "non_vegetarian", "vegan", "jain_vegetarian"] },
        { "key": "alcohol", "label": "Alcohol", "type": "select", "required": false, "visible": true, "visibility": "public", "dependency": {}, "options": ["never", "occasionally", "frequently"] },
        { "key": "smoking", "label": "Smoking", "type": "select", "required": false, "visible": true, "visibility": "public", "dependency": {}, "options": ["never", "occasionally", "frequently"] }
      ],
      "education_and_career": [
        { "key": "education_level", "label": "Education Level", "type": "select", "required": false, "visible": true, "visibility": "public", "dependency": {}, "options": ["high_school", "diploma", "bachelor", "master", "phd", "other"] },
        { "key": "education", "label": "Field / Institution", "type": "text", "required": false, "visible": true, "visibility": "public", "exists": true, "note": "free-text detail kept alongside structured education_level", "dependency": {}, "options": [] },
        { "key": "career", "label": "Occupation", "type": "text", "required": false, "visible": true, "visibility": "public", "exists": true, "note": "existing field serves Occupation", "dependency": {}, "options": [] },
        { "key": "industry", "label": "Industry", "type": "select", "required": false, "visible": true, "visibility": "public", "dependency": {}, "options": ["it_software", "healthcare", "education", "government", "business_finance", "engineering", "arts_media", "agriculture", "hospitality", "self_employed", "student", "other"] },
        { "key": "income_range", "label": "Income Range", "type": "select", "required": false, "visible": true, "visibility": "private", "dependency": {}, "options": ["below_2_5l", "2_5_to_5l", "5_to_10l", "10_to_20l", "above_20l", "prefer_not"], "note": "currency band resolved by nationality (NPR/INR)" }
      ],
      "family": [
        { "key": "family_type", "label": "Family Type", "type": "select", "required": false, "visible": true, "visibility": "public", "dependency": {}, "options": ["joint", "nuclear"] },
        { "key": "family_values", "label": "Family Values", "type": "select", "required": false, "visible": true, "visibility": "public", "dependency": {}, "options": ["traditional", "moderate", "liberal"] },
        { "key": "parents_religion_importance", "label": "Parents Religion Importance", "type": "select", "required": false, "visible": true, "visibility": "public", "dependency": {}, "options": ["very_important", "important", "flexible", "not_important"] }
      ],
      "relationship": [
        { "key": "relationship_intent", "label": "Relationship Goal", "type": "select", "required": false, "visible": true, "visibility": "public", "exists": true, "dependency": {}, "options": ["dating", "serious", "marriage", "marriage_family", "friendship"] },
        { "key": "wants_children", "label": "Wants Children", "type": "select", "required": false, "visible": true, "visibility": "public", "dependency": {}, "options": ["yes", "no", "undecided"] }
      ]
    }
  },
  "partner_preferences": {
    "scope": "partner_preferences",
    "sections": {
      "cultural_preference": [
        { "key": "preferred_religion", "label": "Preferred Religion", "type": "select", "required": false, "visible": true, "exists": true, "source": "api:/preference/cultural/religions/", "dependency": {}, "options": "dynamic" },
        { "key": "preferred_community", "label": "Preferred Community", "type": "select", "required": false, "visible": true, "source": "api:/preference/cultural/communities/?religion={preferred_religion_id}", "dependency": { "field": "preferred_religion", "op": "isSet" }, "options": "dynamic" },
