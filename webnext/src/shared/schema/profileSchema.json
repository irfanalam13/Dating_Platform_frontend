        { "key": "preferred_sub_caste", "label": "Preferred Sub-Caste", "type": "select", "required": false, "visible": true, "source": "api:/preference/cultural/sub-castes/?caste={preferred_caste_v2_id}", "dependency": { "field": "preferred_caste_v2", "op": "isSet" }, "options": "dynamic" },
        { "key": "gotra_rule", "label": "Preferred Gotra Rule", "type": "select", "required": false, "visible": true, "dependency": {}, "options": ["must_differ", "same_ok", "no_preference"] }
