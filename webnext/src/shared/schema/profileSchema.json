      "lifestyle_preference": [
        { "key": "preferred_education", "label": "Preferred Education", "type": "select", "required": false, "visible": true, "exists": true, "dependency": {}, "options": ["", "high_school", "bachelor", "master", "phd"] },
        { "key": "preferred_diet", "label": "Diet Preference", "type": "multiselect", "required": false, "visible": true, "dependency": {}, "options": ["vegetarian", "eggetarian", "non_vegetarian", "vegan", "jain_vegetarian"] },
        { "key": "preferred_alcohol", "label": "Alcohol Preference", "type": "select", "required": false, "visible": true, "dependency": {}, "options": ["", "never", "occasionally", "frequently"] },
        { "key": "preferred_smoking", "label": "Smoking Preference", "type": "select", "required": false, "visible": true, "dependency": {}, "options": ["", "never", "occasionally", "frequently"] }
