        { "key": "max_age", "label": "Max Age", "type": "number", "required": false, "visible": true, "exists": true, "dependency": {}, "options": [] },
        { "key": "preferred_min_height_cm", "label": "Min Height", "type": "number", "unit": "cm", "required": false, "visible": true, "dependency": {}, "options": [] },
        { "key": "preferred_max_height_cm", "label": "Max Height", "type": "number", "unit": "cm", "required": false, "visible": true, "dependency": {}, "options": [] },
        { "key": "max_distance_km", "label": "Distance Range", "type": "select", "required": false, "visible": true, "exists": true, "dependency": {}, "options": [10, 25, 50, 100] }
