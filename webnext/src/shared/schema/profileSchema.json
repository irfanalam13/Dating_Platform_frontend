{
  "version": 1,
  "user_profile": {
    "scope": "user_profile",
    "sections": {
      "basic_information": [
        { "key": "full_name", "label": "Full Name", "type": "text", "required": true, "visible": true, "visibility": "public", "exists": true, "dependency": {}, "options": [] },
        { "key": "gender", "label": "Gender", "type": "select", "required": true, "visible": true, "visibility": "public", "exists": true, "dependency": {}, "options": ["Male", "Female", "Other"] },
        { "key": "date_of_birth", "label": "Date of Birth", "type": "date", "required": true, "visible": true, "visibility": "matches", "exists": true, "dependency": {}, "options": [] },
        { "key": "age", "label": "Age", "type": "number", "required": false, "visible": true, "visibility": "public", "exists": true, "computed": "from date_of_birth", "dependency": {}, "options": [] },
        { "key": "height_cm", "label": "Height", "type": "number", "unit": "cm", "display": "ft/in", "required": false, "visible": true, "visibility": "public", "dependency": {}, "options": [] },
        { "key": "weight_kg", "label": "Weight", "type": "number", "unit": "kg", "required": false, "visible": true, "visibility": "private", "dependency": {}, "options": [] },
        { "key": "city", "label": "Location", "type": "text", "required": true, "visible": true, "visibility": "matches", "exists": true, "dependency": {}, "options": [] },
        { "key": "nationality", "label": "Nationality", "type": "select", "required": false, "visible": true, "visibility": "public", "dependency": {}, "options": ["nepali", "indian", "other"] },
        { "key": "citizenship", "label": "Citizenship", "type": "select", "required": false, "visible": true, "visibility": "private", "dependency": {}, "options": ["nepali", "indian", "dual", "other"] },
        { "key": "languages_spoken", "label": "Languages Spoken", "type": "multiselect", "required": false, "visible": true, "visibility": "public", "dependency": {},
          "options": ["Nepali", "Hindi", "Maithili", "Bhojpuri", "Tharu", "Newari", "Tamang", "Gurung", "Magar", "Limbu", "English", "Bengali", "Tamil", "Telugu", "Kannada", "Malayalam", "Marathi", "Gujarati", "Punjabi", "Urdu", "Other"] }
      ],
      "religion_and_culture": [
        { "key": "religion", "label": "Religion", "type": "select", "required": false, "visible": true, "visibility": "public", "exists": true, "source": "api:/preference/cultural/religions/", "dependency": {}, "options": "dynamic" },
        { "key": "community", "label": "Community / Ethnicity", "type": "select", "required": false, "visible": true, "visibility": "public", "source": "api:/preference/cultural/communities/?religion={religion_id}", "dependency": { "field": "religion", "op": "isSet" }, "options": "dynamic" },
        { "key": "caste_category", "label": "Caste Category", "type": "select", "required": false, "visible": true, "visibility": "public", "source": "api:/preference/cultural/caste-categories/?community={community_id}", "dependency": { "field": "community", "op": "isSet" }, "options": "dynamic" },
        { "key": "caste_v2", "label": "Caste", "type": "select", "required": false, "visible": true, "visibility": "public", "source": "api:/preference/cultural/castes-v2/?category={caste_category_id}", "dependency": { "field": "caste_category", "op": "isSet" }, "options": "dynamic" },
        { "key": "sub_caste", "label": "Sub-Caste", "type": "select", "required": false, "visible": true, "visibility": "public", "source": "api:/preference/cultural/sub-castes/?caste={caste_v2_id}", "dependency": { "field": "caste_v2", "op": "isSet" }, "options": "dynamic" },
        { "key": "clan", "label": "Clan", "type": "select", "required": false, "visible": true, "visibility": "public", "source": "api:/preference/cultural/clans/?sub_caste={sub_caste_id}", "dependency": { "field": "sub_caste", "op": "isSet" }, "options": "dynamic" },
        { "key": "gotra_v2", "label": "Gotra", "type": "select", "required": false, "visible": true, "visibility": "public", "source": "api:/preference/cultural/gotras-v2/?clan={clan_id}", "dependency": { "field": "clan", "op": "isSet" }, "options": "dynamic" },
