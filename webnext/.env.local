# Browser talks to THIS origin only; Next.js proxies /api/v1/* to the backend
# (see rewrites in next.config.ts). A RELATIVE URL keeps the auth cookies
# first-party, so Safari/iOS/macOS keep the refresh cookie instead of dropping it
# as a blocked third-party cookie.
# NEXT_PUBLIC_API_URL=/api/v1
# NEXT_PUBLIC_WS_URL=ws://localhost:8000

# # Server-side only (never shipped to the browser): rewrite proxy target.
# API_PROXY_TARGET=http://localhost:8000

# --- Production: set these in the Vercel dashboard (NOT in this file) ---
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_WS_URL=wss://dating-platform-backend.onrender.com
API_PROXY_TARGET=https://dating-platform-backend.onrender.com
